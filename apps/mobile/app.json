{
  "expo": {
    "name": "Kimbo",
    "slug": "kimbo",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kimbo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.superkalam.kimbo",
      "icon": "./assets/images/icon.png",
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "android": {
      "package": "com.superkalam.kimbo",
      "adaptiveIcon": {
        "backgroundColor": "#F6F8F4",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "runtimeVersion": "1.0.0"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Kimbo uses the camera only when you choose to scan a meal.",
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Kimbo uses the selected photo to estimate the foods in your meal."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Kimbo uses the microphone only while you describe a meal."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F1EC",
          "image": "./assets/images/kimbo-splash.png",
          "imageWidth": 288,
          "dark": {
            "backgroundColor": "#090B0A"
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5405f0cd-6bad-4046-9a1b-01a155aae55f"
      }
    },
    "owner": "herin7",
    "updates": {
      "url": "https://u.expo.dev/5405f0cd-6bad-4046-9a1b-01a155aae55f"
    }
  }
}
